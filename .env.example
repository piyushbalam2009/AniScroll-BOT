# ==============================================================================
# AniScroll Bot — Environment Configuration
# Copy to .env and fill in your credentials. Never commit .env files.
# ==============================================================================

# AI Studio Runtime (injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Discord Application & Bot
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/auth/callback"
DISCORD_OWNER_IDS=""
DISCORD_DEV_GUILD_ID=""
DISCORD_SUPPORT_SERVER_URL="https://discord.gg/aniscroll"

# Database (PostgreSQL for production/Docker; local SQLite fallback path for dev)
DATABASE_URL="postgresql://aniscroll:aniscroll_password@localhost:5432/aniscroll_bot?schema=public"
SQLITE_DB_PATH="./data/aniscroll.db"

# Redis Cache
REDIS_URL="redis://localhost:6379"
CACHE_PREFIX="aniscroll:v1"
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_DETAILS_SECONDS=1800
CACHE_TTL_EPISODES_SECONDS=900
CACHE_TTL_TRENDING_SECONDS=600
CACHE_TTL_SEASONAL_SECONDS=3600
CACHE_TTL_GENRES_SECONDS=86400

# Hoshika API (Direct anime metadata — never proxy via api.aniscroll.in)
HOSHIKA_BASE_URL="https://hoshika.app/api/v1"
# Optional partner API key if provided by Hoshika
HOSHIKA_API_KEY=""

# Existing AniScroll API & Website Shared Watchlist API
ANISCROLL_API_BASE_URL="https://api.aniscroll.in"
ANISCROLL_WEB_BASE_URL="https://aniscroll.in"
ANISCROLL_WEBSITE_API_URL="https://aniscroll.in"
ANISCROLL_BOT_API_SECRET=""
ANISCROLL_WEBHOOK_SECRET=""

# Lavalink v4 Audio Node (Purchased server configuration)
LAVALINK_HOST="lavalink.cloudewave.in"
LAVALINK_PORT="2347"
LAVALINK_PASSWORD=""
LAVALINK_SECURE="false"

# Spotify Metadata Lookup & Playable Match Resolution (Optional - required for Spotify URLs/spsearch)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
YOUTUBE_OAUTH_REFRESH_TOKEN=""

# Dashboard & API Security
SESSION_SECRET="replace-with-at-least-32-character-random-secret"
DASHBOARD_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="development"

# Status Monitoring & Website Updates System
ANISCROLL_STATUS_MONITOR_ENABLED="true"
ANISCROLL_STATUS_CHECK_INTERVAL="60"
ANISCROLL_STATUS_TIMEOUT="10000"
ANISCROLL_STATUS_FAILURE_THRESHOLD="3"
ANISCROLL_STATUS_RECOVERY_THRESHOLD="2"
ANISCROLL_WEBSITE_URL="https://aniscroll.in"
ANISCROLL_STREAMING_API_URL="https://anivault-scraper-five.vercel.app"
ANISCROLL_HOSHIKA_API_URL="https://hoshika.app/api/v1"
ANISCROLL_STATUS_CHANNEL_ID=""
ANISCROLL_UPDATES_CHANNEL_ID=""
ANISCROLL_STATUS_TIMEZONE="Asia/Kolkata"

